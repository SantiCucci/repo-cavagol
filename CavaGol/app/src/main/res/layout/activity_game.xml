<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_top_bar"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jugador"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoundCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jugada 1/10"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:id="@+id/videoFrame"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_video_frame"
                        android:padding="4dp"
                        app:layout_constraintDimensionRatio="H,16:9"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <VideoView
                            android:id="@+id/videoView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ImageButton
                            android:id="@+id/btnExpand"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="#80000000"
                            android:src="@android:drawable/ic_menu_view"
                            android:contentDescription="Ver en pantalla completa"
                            android:scaleType="centerInside"
                            android:padding="6dp" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewind_button"
                    android:src="@android:drawable/ic_media_rew"
                    android:contentDescription="Volver a ver la jugada"
                    android:scaleType="centerInside"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Qué pasa a continuación?"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnOptionA"
                    style="@style/OptionButtonStyle"
                    android:text="A" />

                <Button
                    android:id="@+id/btnOptionB"
                    style="@style/OptionButtonStyle"
                    android:text="B" />

                <Button
                    android:id="@+id/btnOptionC"
                    style="@style/OptionButtonStyle"
                    android:text="C" />

                <Button
                    android:id="@+id/btnOptionD"
                    style="@style/OptionButtonStyle"
                    android:text="D" />

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_feedback"
                    android:padding="14dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:visibility="invisible"
                    android:text="¡FELICITACIONES! ACERTASTE" />

                <Button
                    android:id="@+id/btnNextRound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_option_default"
                    android:backgroundTint="@null"
                    android:text="Siguiente ronda ▶"
                    android:visibility="invisible" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnCollapse"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="#80000000"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Salir de pantalla completa"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </FrameLayout>

</FrameLayout>
